{
    "compilerOptions": {
        "allowJs": true,
        "moduleResolution": "bundler",
        "module": "esnext",
        "target": "esnext",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "importHelpers": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "stripInternal": true,
        "jsxImportSource": "preact",
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": {
            "@integration-components/domain-integration": ["packages/shared/domain-integration/src/index"],
            "@integration-components/domain-integration/*": ["packages/shared/domain-integration/src/*"],
            "@integration-components/types": ["packages/shared/types/src/index"],
            "@integration-components/types/*": ["packages/shared/types/src/*"],
            "@integration-components/assets": ["packages/shared/assets/src/index"],
            "@integration-components/assets/*": ["packages/shared/assets/src/*"],
            "@integration-components/utils": ["packages/shared/utils/src/index"],
            "@integration-components/utils/*": ["packages/shared/utils/src/*"],
            "@integration-components/style": ["packages/shared/style/index"],
            "@integration-components/core": ["packages/shared/core/src/index"],
            "@integration-components/core/vue": ["packages/shared/core/src/vue/index"],
            "@integration-components/core/preact": ["packages/shared/core/src/preact/index"],
            "@integration-components/core/preact/*": ["packages/shared/core/src/preact/*"],
            "@integration-components/core/*": ["packages/shared/core/src/*"],
            "@integration-components/sdk-internal": ["packages/shared/lib/src/index"],
            "@integration-components/sdk-internal/*": ["packages/shared/lib/src/*"],
            "@integration-components/hooks-preact": ["packages/shared/hooks-preact/src/index"],
            "@integration-components/hooks-preact/*": ["packages/shared/hooks-preact/src/*"],
            "@integration-components/ui-components-preact": ["packages/shared/ui-components-preact/src/index"],
            "@integration-components/ui-components-preact/*": ["packages/shared/ui-components-preact/src/*"],
            "@integration-components/composables-vue": ["packages/shared/composables-vue/src/index"],
            "@integration-components/composables-vue/*": ["packages/shared/composables-vue/src/*"],
            "@integration-components/testing": ["packages/shared/testing/src/index"],
            "@integration-components/testing/*": ["packages/shared/testing/src/*"],
            "@integration-components/reports/publish": ["packages/domains/reports/publish/src/index"],
            "@integration-components/reports/preact": ["packages/domains/reports/preact/src/index"],
            "@integration-components/reports/domain": ["packages/domains/reports/domain/src/index"],
            "@integration-components/payouts/publish": ["packages/domains/payouts/publish/src/index"],
            "@integration-components/payouts/preact": ["packages/domains/payouts/preact/src/index"],
            "@integration-components/payouts/domain": ["packages/domains/payouts/domain/src/index"],
            "@integration-components/transactions/publish": ["packages/domains/transactions/publish/src/index"],
            "@integration-components/transactions/preact": ["packages/domains/transactions/preact/src/index"],
            "@integration-components/transactions/domain": ["packages/domains/transactions/domain/src/index"],
            "@integration-components/disputes/publish": ["packages/domains/disputes/publish/src/index"],
            "@integration-components/disputes/preact": ["packages/domains/disputes/preact/src/index"],
            "@integration-components/disputes/domain": ["packages/domains/disputes/domain/src/index"],
            "@integration-components/payByLink/publish": ["packages/domains/payByLink/publish/src/index"],
            "@integration-components/payByLink/preact": ["packages/domains/payByLink/preact/src/index"],
            "@integration-components/payByLink/domain": ["packages/domains/payByLink/domain/src/index"],
            "@integration-components/capital/publish": ["packages/domains/capital/publish/src/index"],
            "@integration-components/capital/preact": ["packages/domains/capital/preact/src/index"],
            "@integration-components/capital/domain": ["packages/domains/capital/domain/src/index"]
        },
        "types": ["node"]
    }
}
