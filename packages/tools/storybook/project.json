{
    "name": "@integration-components/tools-storybook",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "packages/tools/storybook/src",
    "tags": ["type:tool", "scope:storybook"],
    "targets": {
        "storybook:preact": {
            "executor": "nx:run-script",
            "options": {
                "script": "storybook:preact"
            }
        },
        "storybook:vue": {
            "executor": "nx:run-script",
            "options": {
                "script": "storybook:vue"
            }
        },
        "storybook:build:preact": {
            "executor": "nx:run-script",
            "options": {
                "script": "storybook:build:preact"
            },
            "outputs": ["{projectRoot}/storybook-static"],
            "cache": true
        },
        "storybook:build:vue": {
            "executor": "nx:run-script",
            "options": {
                "script": "storybook:build:vue"
            },
            "outputs": ["{projectRoot}/storybook-static"],
            "cache": true
        },
        "storybook:static:preact": {
            "executor": "nx:run-script",
            "options": {
                "script": "storybook:static:preact"
            },
            "outputs": ["{projectRoot}/storybook-static"]
        },
        "storybook:static:vue": {
            "executor": "nx:run-script",
            "options": {
                "script": "storybook:static:vue"
            },
            "outputs": ["{projectRoot}/storybook-static"]
        },
        "types:check": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/typecheck.js",
                "cwd": "{projectRoot}"
            },
            "outputs": [],
            "cache": true
        },
        "types:watch": {
            "executor": "nx:run-commands",
            "options": {
                "command": "node scripts/typecheck.js --watch",
                "cwd": "{projectRoot}"
            },
            "cache": false
        }
    }
}
