{
    "name": "@integration-components/integration-demo",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "Standalone app for testing the published @adyen/adyen-platform-experience-web package integration",
    "scripts": {
        "demo:dev": "vite",
        "demo:build": "vite build",
        "demo:typecheck": "tsc --noEmit",
