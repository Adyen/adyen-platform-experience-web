        "react-router": "^6.30.1",
        "react-router-dom": "^6.30.1",
        "vite": "catalog:"
    },
    "devDependencies": {
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.2",
        "tsx": "^4.21.0",
        "typescript": "catalog:",
        "verdaccio": "^6.1.2"
    }
}
