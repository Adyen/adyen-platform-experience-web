{
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "target": "es2016",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "noEmit": true
    }
}
