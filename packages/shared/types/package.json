{
    "name": "@integration-components/types",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json",
        "./theme": {
            "types": "./src/theme.d.ts",
            "default": "./src/theme.js"
        },
        "./*": "./src/*.ts"
    }
}
