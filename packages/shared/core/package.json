{
    "name": "@integration-components/core",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./package.json": "./package.json",
        "./EventDispatcher": "./src/EventDispatcher/index.ts",
        "./Errors/constants": "./src/Errors/constants.ts",
        "./Localization": "./src/Localization/index.ts",
        "./Localization/Localization": "./src/Localization/Localization.ts",
        "./Localization/amount/amount-util": "./src/Localization/amount/amount-util.ts",
        "./Localization/constants/localization": "./src/Localization/constants/localization.ts",
        "./translation-contract": "./src/translation-contract/index.ts",
        "./translations": "./src/translations/index.ts",
        "./translations/local": "./src/translations/local.ts",
        "./vue": "./src/vue/index.ts",
        "./preact": "./src/preact/index.ts",
        "./*": "./src/*.ts"
    },
    "dependencies": {
        "@integration-components/assets": "workspace:*",
        "@integration-components/sdk-localization": "workspace:*",
        "@integration-components/types": "workspace:*",
        "@integration-components/utils": "workspace:*",
        "classnames": "catalog:"
    },
    "devDependencies": {
        "@adyen/bento-vue3": "catalog:",
        "vue": "catalog:",
        "vue-i18n": "^11",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "@adyen/bento-vue3": "catalog:",
        "preact": "catalog:",
        "vue": "catalog:",
        "vue-i18n": "^11"
    },
    "peerDependenciesMeta": {
        "@adyen/bento-vue3": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "vue-i18n": {
            "optional": true
        }
    }
}
