{
    "name": "@integration-components/sdk",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "sideEffects": [
        "**/*.css",
        "**/*.scss"
    ],
    "scripts": {
        "build:clean": "rimraf ../../dist",
        "build:bundle": "vite build",
        "build:types": "tsc --project tsconfig-build.json && tsc-alias -p tsconfig-build.json --dir ../../dist/types"
    },
    "dependencies": {
        "@integration-components/sdk-internal": "workspace:*",
        "@integration-components/style": "workspace:*",
        "vue": "catalog:",
        "vue-i18n": "catalog:"
    },
    "devDependencies": {
        "@integration-components/testing": "workspace:*",
        "@playwright/test": "catalog:",
        "@storybook/vue3": "catalog:",
        "@vitejs/plugin-vue": "^6.0.5",
        "rimraf": "6.1.3",
        "terser": "5.46.2",
        "tsc-alias": "^1.8.17",
        "vite": "catalog:"
    }
}
