{
    "name": "@integration-components/sdk",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/sdk/src",
    "tags": ["type:publish"],
    "targets": {
        "build": {
            "executor": "nx:noop",
            "dependsOn": ["build:bundle", "build:types"],
            "outputs": []
        },
        "build:clean": {
            "cache": false
        },
        "build:bundle": {
            "dependsOn": ["^build", "build:clean"],
            "outputs": ["{workspaceRoot}/dist/es", "{workspaceRoot}/dist/cjs", "{workspaceRoot}/dist/*.{cjs,map,css}"],
            "cache": true
        },
        "build:types": {
            "dependsOn": ["^build", "build:clean"],
            "outputs": ["{workspaceRoot}/dist/types"],
            "cache": true
        },
        "types:check": {},
        "types:watch": {}
    }
}
