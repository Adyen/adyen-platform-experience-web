{
    "name": "@adyen/adyen-platform-experience-web",
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "src",
    "tags": ["type:publish"],
    "targets": {
        "build:umd": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vite --mode umd build --config vite.config.ts && tsc --project tsconfig-build.json"
            },
            "outputs": ["{workspaceRoot}/dist/umd", "{workspaceRoot}/dist/types"],
            "cache": true
        },
        "build:umd:test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "cross-env USE_TEST_CDN=true vite --mode umd build --config vite.config.ts && tsc --project tsconfig-build.json"
            },
            "outputs": ["{workspaceRoot}/dist/umd", "{workspaceRoot}/dist/types"],
            "cache": true
        },
        "build:analyse": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vite build --mode analyse --config vite.config.ts"
            },
            "outputs": ["{workspaceRoot}/dist"],
            "cache": true
        },
        "lint": {
            "executor": "nx:run-commands",
            "dependsOn": ["lint:playwright-selectors"],
            "options": {
              "commands": [
                "eslint '{src,packages}/**/*.{js,ts,tsx,vue}' --quiet",
                "stylelint 'packages/**/*.scss'"
              ],
              "parallel": false
            },
            "cache": true
        },
        "lint:playwright-selectors": {
            "executor": "nx:run-commands",
            "options": {
                "command": "eslint --no-config-lookup --config scripts/eslint-playwright-selectors.cjs 'packages/domains/**/tests/**/*.{spec,test}.{ts,tsx}' 'packages/shared/testing/src/playwright/**/*.{ts,tsx}'"
            },
            "cache": true
        },
        "types:check": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc --noEmit --project {projectRoot}/tsconfig.json"
            },
            "outputs": [],
            "cache": true
        },
        "types:watch": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc --noEmit --project {projectRoot}/tsconfig.json --watch"
            },
            "cache": false
        }
    }
}
