{
    "name": "@adyen/adyen-platform-experience-web",
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "src",
    "tags": ["type:publish"],
    "targets": {
        "build:analyse": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vite build --mode analyse --config vite.config.ts"
            },
            "outputs": ["{workspaceRoot}/dist"],
            "cache": true
        },
        "lint": {
            "executor": "nx:run-commands",
            "dependsOn": ["lint:playwright-selectors"],
            "inputs": ["default", "{workspaceRoot}/**/*"],
            "options": {
                "commands": ["eslint . --max-warnings 0", "stylelint 'packages/**/*.scss' --max-warnings 0 --report-needless-disables"],
                "parallel": false
            },
            "cache": true
        },
        "lint:playwright-selectors": {
            "executor": "nx:run-commands",
            "options": {
                "command": "eslint --no-config-lookup --config scripts/eslint-playwright-selectors.cjs 'packages/domains/**/tests/**/*.{spec,test}.ts' 'packages/sdk/tests/**/*.{spec,test}.ts' 'packages/shared/testing/**/*.ts'"
            },
            "cache": true
        },
        "types:check": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vue-tsc --noEmit --project {projectRoot}/tsconfig.json"
            },
            "outputs": [],
            "cache": true
        },
        "types:watch": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vue-tsc --noEmit --project {projectRoot}/tsconfig.json --watch"
            },
            "cache": false
        }
    }
}
