{
    "name": "@adyen/adyen-platform-experience-web",
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "src",
    "tags": ["type:publish"],
    "targets": {
        "types:check": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc --noEmit --project {projectRoot}/tsconfig.json"
            },
            "outputs": [],
            "cache": true
        },
        "types:watch": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc --noEmit --project {projectRoot}/tsconfig.json --watch"
            },
            "cache": false
        }
    }
}
