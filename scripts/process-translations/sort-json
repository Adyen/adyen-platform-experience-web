#!/usr/bin/env node

// Reads the JSON payload from stdin. The payload must not be passed as a command-line argument:
// OS limits for a single argument (~128KB on Linux, ~1MB on macOS) are smaller than the SDK
// translation catalogs, and exceeding them fails the spawn with E2BIG.
process.stdin.setEncoding('utf8');

let source = '';

process.stdin.on('data', chunk => {
    source += chunk;
});

process.stdin.on('end', () => {
    try {
        const sourceObj = JSON.parse(source);

        // JSON string with keys sorted in alphabetical order (case-insensitive)
        const sortedJSON = JSON.stringify(
            Object.fromEntries(
                Object.entries(sourceObj)
                    .sort(([a], [b]) => a.localeCompare(b))
            )
        );

        // JSON string for the source object
        const sourceJSON = JSON.stringify(sourceObj);

        if (sortedJSON !== sourceJSON) {
            // json mismatch:
            // one or more keys are out of order
            // write sorted json to stdout
            console.log(sortedJSON);
        }
    } catch (ex) {
        console.error(ex);
        process.exitCode = 1;
    }
});
