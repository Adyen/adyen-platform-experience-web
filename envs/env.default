#================ PLAYGROUND =================#
#  Config for application host, port and URL  #
#=============================================#
PLAYGROUND_PORT=3030
PLAYGROUND_HOST=localhost
PLAYGROUND_URL=http://$PLAYGROUND_HOST:$PLAYGROUND_PORT/


#============== LOADING CONTEXT ==============#
#  Override platform components API base URL  #
# Only set this if you know what you're doing #
#=============================================#
# LOADING_CONTEXT=

#==================== CDN ====================#
# Prefer the CDN over local /assets directory #
# Set to true if you want assets from the CDN #
#=============================================#
USE_CDN=true

#========== SESSION API INTEGRATION ==========#
#  Necessary (during development) for making  #
#   proxied API calls to /sessions endpoint   #
#=============================================#
SESSION_API_URL=https://test.adyen.com/
SESSION_ACCOUNT_HOLDER=
API_KEY=


#============== PIET CHAT API ================#
#  OpenAI-compatible chat backend used by the #
#  API-connected Piet story. The URL and key  #
#  are only read by the dev-server proxy and  #
#  never reach the browser; the model name is #
#  injected into the story. Values may        #
#  reference shell variables, e.g.            #
#  PIET_CHAT_API_KEY=${MY_KEY}                #
#=============================================#
# PIET_CHAT_API_URL=
# PIET_CHAT_API_KEY=
# PIET_CHAT_MODEL=
