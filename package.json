{
  "name": "@adyen/adyen-platform-experience-web",
  "version": "1.13.0-rc.0",
  "keywords": [
    "adyen",
    "adyen-pe",
    "fp",
    "finance",
    "platforms",
    "adyen-for-platforms",
    "components",
    "adyen-platform-experience"
  ],
  "license": "MIT",
  "type": "module",
  "repository": "github:Adyen/adyen-platform-experience-web",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "bugs": {
    "url": "https://support.adyen.com/"
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": [
    "**/*.css",
    "**/global.{js,ts}"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/packages/sdk/src/index.js",
  "types": "./dist/types/packages/sdk/src/index.d.ts",
  "style": "./dist/adyen-platform-experience-web.css",
  "exports": {
    ".": {
      "types": "./dist/types/packages/sdk/src/index.d.ts",
      "require": {
        "types": "./dist/types/packages/sdk/src/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "import": {
        "types": "./dist/types/packages/sdk/src/index.d.ts",
        "default": "./dist/es/packages/sdk/src/index.js"
      }
    },
    "./adyen-platform-experience-web.css": "./dist/adyen-platform-experience-web.css"
  },
  "scripts": {
    "build": "nx run @integration-components/sdk:build",
    "build:umd": "nx run @adyen/adyen-platform-experience-web:build:umd",
    "build:umd:test": "nx run @adyen/adyen-platform-experience-web:build:umd:test",
    "build:analyse": "nx run @adyen/adyen-platform-experience-web:build:analyse",
    "build:publish": "pnpm run build && pnpm pack",
    "changeset": "changeset",
    "format": "prettier --write '{src,packages}/**/*.{ts,tsx,js,css,scss,html,vue}'",
    "check-publish-contract": "pnpm run build && tsx scripts/check-publish-contract/check.ts",
    "check-publish-contract:update": "pnpm run build && tsx scripts/check-publish-contract/check.ts --update",
    "lint": "nx run @adyen/adyen-platform-experience-web:lint",
    "lint:playwright-selectors": "nx run @adyen/adyen-platform-experience-web:lint:playwright-selectors",
    "prepare": "node prepare.cjs",
    "schemas:generate": "bash scripts/generate-ts-schemas/generate-schemas.sh",
    "schemas:variables": "bash scripts/generate-ts-schemas/setup-openapi-ts.sh",
    "start": "pnpm run storybook",
    "start:vue": "pnpm run storybook:vue",
    "storybook": "concurrently --kill-others-on-fail 'pnpm run types:watch' 'nx run @integration-components/tools-storybook:storybook:preact'",
    "storybook:vue": "concurrently --kill-others-on-fail 'pnpm run types:watch' 'nx run @integration-components/tools-storybook:storybook:vue'",
    "storybook:build": "pnpm run storybook:build:preact",
    "storybook:build:preact": "nx run @integration-components/tools-storybook:storybook:build:preact",
    "storybook:build:vue": "nx run @integration-components/tools-storybook:storybook:build:vue",
    "storybook:static": "pnpm run storybook:static:preact",
    "storybook:static:preact": "nx run @integration-components/tools-storybook:storybook:static:preact",
    "storybook:static:vue": "nx run @integration-components/tools-storybook:storybook:static:vue",
    "test": "cross-env TEST_ENV=1 nx run @adyen/adyen-platform-experience-web:unit",
    "test:contract": "cross-env NODE_OPTIONS='--no-experimental-strip-types' playwright test --project contract",
    "test:coverage": "vitest run --config vite.config.ts --coverage",
    "test:integration": "cross-env TEST_ENV=1 NODE_OPTIONS='--no-experimental-strip-types' playwright test --project local-chrome",
    "test:integration:preact": "cross-env STORYBOOK_FRAMEWORK=preact pnpm run test:integration",
    "test:integration:vue": "cross-env STORYBOOK_FRAMEWORK=vue pnpm run test:integration",
    "test:integration:ui": "pnpm run test:integration --ui",
    "translations:sort": "bash scripts/process-translations/sort-translations-json.sh",
    "types:check": "nx run-many --target=types:check",
    "types:watch": "concurrently --kill-others-on-fail 'nx run-many --target=types:watch' 'tsc --project tsconfig-build.json --watch'",
    "version": "./scripts/bump-version.sh"
  },
  "dependencies": {
    "core-js": "^3.36.0"
  },
  "devDependencies": {
    "@adyen/bento-design-tokens": "^1.7.1",
    "@changesets/cli": "2.29.8",
    "@changesets/get-github-info": "^0.6.0",
    "@eslint/js": "^9.39.2",
    "@integration-components/assets": "workspace:*",
    "@integration-components/capital": "workspace:*",
    "@integration-components/core": "workspace:*",
    "@integration-components/disputes": "workspace:*",
    "@integration-components/hooks-preact": "workspace:*",
    "@integration-components/payByLink": "workspace:*",
    "@integration-components/payouts": "workspace:*",
    "@integration-components/reports": "workspace:*",
    "@integration-components/style": "workspace:*",
    "@integration-components/testing": "workspace:*",
    "@integration-components/transactions": "workspace:*",
    "@integration-components/types": "workspace:*",
    "@integration-components/ui-components-preact": "workspace:*",
    "@integration-components/utils": "workspace:*",
    "@nx/eslint": "^22.5.3",
    "@nx/eslint-plugin": "^22.5.3",
    "@nx/vite": "^22.5.3",
    "@nx/vitest": "^22.5.3",
    "@playwright/test": "catalog:",
    "@preact/preset-vite": "^2.10.2",
    "@storybook/preact": "catalog:",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/preact": "catalog:",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.13",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "catalog:",
    "autoprefixer": "^10.4.20",
    "concurrently": "^7.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "dotenv": "catalog:",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-testing-library": "^7.1.1",
    "eslint-plugin-vue": "^9.33.0",
    "file-loader": "^6.2.0",
    "globals": "^17.6.0",
    "husky": "^7.0.4",
    "jsdom": "^26.1.0",
    "lint-staged": "^13.0.1",
    "mini-css-extract-plugin": "^2.4.5",
    "msw": "catalog:",
    "msw-storybook-addon": "^2.0.2",
    "nx": "^22.5.3",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.3.11",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^5.9.0",
    "sass": "^1.77.6",
    "sass-loader": "^12.3.0",
    "storybook": "catalog:",
    "style-loader": "^3.3.1",
    "stylelint": "^17.5.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-scss": "^7.0.0",
    "ts-loader": "^9.2.6",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "catalog:",
    "vue-eslint-parser": "^10.4.0",
    "webpack": "catalog:"
  }
}